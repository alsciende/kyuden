HTTP_PORT=80

# openssl rand -hex 32
APP_SECRET=
MERCURE_JWT_SECRET=

POSTGRES_USER=kyuden
POSTGRES_PASSWORD=
POSTGRES_DB=kyuden

MAILER_DSN=null://null
# the bot of the platform that plays the introductory games (app:user:create)
HOUSE_BOT_ID=kyuden-bot
