# copy to docker/production/.env (not committed): read by compose, what the services share; the rest of the
# environment of the application is symfony.env (symfony.env.dist)
# the values below run the stack on a workstation (make prod-up); in production, replace them all, the secrets first

# the domain of the site (in production: kyuden.app, its DNS pointing to the host, ports 80 and 443 open), or ":80"
# for HTTP only
SERVER_NAME=:80
# the ports of the host (in production: 80 and 443, the defaults of compose.yaml)
HTTP_PORT=8080
HTTPS_PORT=8443

# the release deployed: the git tag of the images (ghcr.io/alsciende/kyuden-app); "local": the images
# of make prod-build
KYUDEN_VERSION=local

# openssl rand -hex 32 (the Mercure hub and the application)
MERCURE_JWT_SECRET=change-me-in-production-0123456789abcdef

# the database and the DATABASE_URL of the application (a password without characters to escape in a URL)
POSTGRES_USER=kyuden
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kyuden
