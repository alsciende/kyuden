# copy to docker/production/.env (not committed): read by compose, what the services share; the rest of the
# environment of the application is symfony.env (symfony.env.dist)
HTTP_PORT=80

# the release deployed: the git tag of the images (ghcr.io/alsciende/kyuden-php and kyuden-nginx)
KYUDEN_VERSION=

# openssl rand -hex 32 (Mercure and the application)
MERCURE_JWT_SECRET=

# the database and the DATABASE_URL of the application (a password without characters to escape in a URL)
POSTGRES_USER=kyuden
POSTGRES_PASSWORD=
POSTGRES_DB=kyuden
