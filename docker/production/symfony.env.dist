# copy to docker/production/symfony.env (not committed): mounted as the .env of the application in the app container
# set by the image: APP_ENV (prod), APP_DEBUG (0); set by compose from docker/production/.env: DATABASE_URL,
# MERCURE_URL, MERCURE_JWT_SECRET
# the values below run the stack on a workstation (make prod-up); in production, replace them, the secret first

# openssl rand -hex 32
APP_SECRET=change-me-in-production-0123456789abcdef

# the hosts the application answers for, regular expressions separated by commas (another host: 400); also the
# protection of the MCP server against DNS rebinding; in production: '^kyuden\.app$'
SYMFONY_TRUSTED_HOSTS='^(localhost|127\.0\.0\.1)$'

# the proxies whose X-Forwarded-For gives the address of the client (the limits of the sign-in by IP), separated by
# commas: the ranges of Cloudflare, in front of the site (https://www.cloudflare.com/ips/, to update when they change);
# harmless on a workstation, where no request comes from them
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# the hub as the browsers reach it, on the origin of the site
MERCURE_PUBLIC_URL=/.well-known/mercure

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null

# the bot of the platform that plays the introductory games, created on start (app:house-bot:create)
HOUSE_BOT_ID=kyuden-bot

# the credentials of the application at each provider of identities (OAuth2): a provider without a client id is
# disabled; the redirect URI to register there is https://<SERVER_NAME>/oauth/<provider>/callback
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# the images of the cards, <base>/cards/<code>.webp (the bucket R2 kyuden-images; this value by default)
CARD_IMAGES_URL=https://images.kyuden.app/v1

# the credentials to Sentry for log monitoring
SENTRY_DSN=
