# copy to docker/production/symfony.env (not committed): mounted as the .env of the application in the app container
# set by the image: APP_ENV (prod), APP_DEBUG (0); set by compose from docker/production/.env: DATABASE_URL,
# MERCURE_URL, MERCURE_JWT_SECRET
# the values below run the stack on a workstation (make prod-up); in production, replace them, the secret first

# openssl rand -hex 32
APP_SECRET=change-me-in-production-0123456789abcdef

# the hub as the browsers reach it, on the origin of the site
MERCURE_PUBLIC_URL=/.well-known/mercure

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null

# the bot of the platform that plays the introductory games, created on start (app:house-bot:create)
HOUSE_BOT_ID=kyuden-bot

# the credentials of the application at each provider of identities (OAuth2): a provider without a client id is
# disabled; the redirect URI to register there is https://<SERVER_NAME>/oauth/<provider>/callback
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
